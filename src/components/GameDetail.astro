---
import { fmtDate, relText, availableLinks, buildJsonLd, slugify, displayTitle, translateGenres, buildFaqItems, effectiveStatus, isGameFaqIndexable, isGameReleaseIndexable, isGameNewsIndexable, listSeparator } from "../lib/games.js";
import { t } from "../i18n/ui.js";
import { PRODUCT } from "../i18n/product.js";
import gamesData from "../../data/games.json";
import newsData from "../../data/news.json";
import GameCard from "./GameCard.astro";

const { game, pageUrl, locale, isDraft = false } = Astro.props;
const links = availableLinks(game, locale);
const jsonLd = buildJsonLd(game, pageUrl, locale);
const title = displayTitle(game, locale);
const genresLocalized = translateGenres(game.genres, locale);

// 同类型游戏：跟当前游戏共享至少一个类型标签、排除自己、按热度排序，取前 4 个。
// 类型标签是从 Excel 选题库来的自由文本，同一个类型不同游戏之间大小写、措辞可能有细微差异
// （比如 "RPG" 和 "rpg"），比较之前先用 slugify 归一化，不然会漏掉本来该算相关的游戏。
// 这是真实存在的内部链接（不是硬凑的相关推荐），能帮用户继续在站内逛，也给搜索引擎
// 多一条从这款游戏爬到其他游戏页面的路径。
const gameGenreSlugs = new Set((game.genres || []).map((g) => slugify(g)));
const relatedGames = (gameGenreSlugs.size
  ? gamesData.games
      .filter((g) => g.slug !== game.slug && g.genres?.some((genre) => gameGenreSlugs.has(slugify(genre))))
      .sort((a, b) => (b.hype ?? 0) - (a.hype ?? 0))
  : []
).slice(0, 4);
const gameNews = newsData.items
  .filter((item) => item.relatedSlug === game.slug)
  .sort((a, b) => String(b.publishedAt).localeCompare(String(a.publishedAt)));
const latestUpdate = gameNews[0];
const hasGameNews = isGameNewsIndexable(game, locale, gameNews);
const editorial = game.content?.[locale] || {};
const status = effectiveStatus(game);
const faqIndexable = isGameFaqIndexable(game, locale);
const releaseIndexable = isGameReleaseIndexable(game, locale);
const separator = listSeparator(locale);
const product = PRODUCT[locale] || PRODUCT.en;
const dataUpdated = fmtDate(String(gamesData.generatedAt).slice(0, 10), locale);
const releaseRelative = (status === "upcoming" && game.release !== "TBA")
  ? ((locale === "zh" || locale === "ja") ? `（${relText(game, locale)}）` : ` (${relText(game, locale)})`)
  : "";
const copy = {
  en: {
    overview: "Game overview", overviewText: `${title} is ${status === "upcoming" ? "an upcoming" : "a released"} ${genresLocalized.join(" and ") || "video game"}${game.developer ? ` developed by ${game.developer}` : ""}. This hub tracks confirmed release information, platforms, official resources, and new player guides as reliable details become available.`,
    quick: "Quick answers", guides: "Guide coverage", guidesText: "Guide sections are published only when they contain a concrete, source-supported answer. Planned coverage may include beginner help, quests, characters, items, builds, locations, and troubleshooting where relevant to this game.",
    releaseQ: `When does ${title} release?`, platformQ: `What platforms is ${title} on?`, developerQ: `Who is making ${title}?`,
    fullWiki: "Open the complete independent wiki", fullWikiSub: "Walkthroughs, databases, builds, and deeper player help", verified: "Confirmed information", updated: "This page is refreshed from structured game data and reviewed resources. Unconfirmed details are not presented as facts.", sources: "Sources", guidesCta: "View guides"
  },
  es: {
    overview: "Resumen del juego", overviewText: `${title} es un videojuego ${genresLocalized.join(" y ") || ""}${game.developer ? ` desarrollado por ${game.developer}` : ""}. Este centro reúne la fecha, plataformas y recursos confirmados.`,
    quick: "Respuestas rápidas", guides: "Cobertura de guías", guidesText: "Las guías se publican cuando contienen respuestas concretas y respaldadas por fuentes.",
    releaseQ: `¿Cuándo se lanza ${title}?`, platformQ: `¿En qué plataformas estará ${title}?`, developerQ: `¿Quién desarrolla ${title}?`,
    fullWiki: "Abrir la wiki independiente completa", fullWikiSub: "Guías y recursos detallados para jugadores", verified: "Información confirmada", updated: "Los datos no confirmados no se presentan como hechos.", sources: "Fuentes", guidesCta: "Ver guías"
  },
  zh: {
    overview: "游戏概览", overviewText: `${title}是一款${genresLocalized.join("、") || "电子游戏"}${game.developer ? `，由 ${game.developer} 开发` : ""}。本页汇总已经确认的发行日期、平台和官方资源。`,
    quick: "快速解答", guides: "攻略覆盖", guidesText: "只有能提供明确答案并有可靠来源的攻略栏目才会公开发布。后续可按游戏实际内容扩展任务、角色、物品、Build、地点及故障排查。",
    releaseQ: `${title}什么时候发行？`, platformQ: `${title}登陆哪些平台？`, developerQ: `${title}由谁开发？`,
    fullWiki: "进入完整独立攻略 Wiki", fullWikiSub: "查看任务、数据库、Build 与深度攻略", verified: "已确认信息", updated: "页面根据结构化游戏资料和可靠来源更新，不把未确认消息当作事实。", sources: "信息来源", guidesCta: "查看攻略"
  },
  de: {
    overview: "Spielübersicht", overviewText: `${title} ist ${status === "upcoming" ? "ein kommendes" : "ein veröffentlichtes"} ${genresLocalized.join("- und ") || "Videospiel"}${game.developer ? ` von ${game.developer}` : ""}. Dieser Hub bündelt bestätigte Angaben zu Veröffentlichung, Plattformen, offiziellen Quellen und Spielerhilfen.`,
    quick: "Kurzantworten", guides: "Guide-Abdeckung", guidesText: "Guides werden nur veröffentlicht, wenn sie eine konkrete und durch Quellen belegte Antwort liefern. Je nach Spiel folgen Einsteigerhilfen, Quests, Charaktere, Gegenstände, Builds, Orte und Fehlerbehebung.",
    releaseQ: `Wann erscheint ${title}?`, platformQ: `Für welche Plattformen erscheint ${title}?`, developerQ: `Wer entwickelt ${title}?`,
    fullWiki: "Vollständiges unabhängiges Wiki öffnen", fullWikiSub: "Walkthroughs, Datenbanken, Builds und ausführliche Spielerhilfen", verified: "Bestätigte Informationen", updated: "Diese Seite wird anhand strukturierter Spieldaten und geprüfter Quellen aktualisiert. Unbestätigte Angaben werden nicht als Tatsachen dargestellt.", sources: "Quellen", guidesCta: "Guides ansehen"
  },
  ja: {
    overview: "ゲーム概要", overviewText: `${title}は${genresLocalized.join("・") || "ゲーム"}${game.developer ? `で、${game.developer}が開発しています` : "です"}。このハブでは、発売日、対応プラットフォーム、公式情報、プレイヤー向けガイドを確認済み情報に基づいてまとめています。`,
    quick: "クイック回答", guides: "攻略ガイド", guidesText: "具体的な回答と信頼できる根拠があるガイドのみ公開します。ゲーム内容に応じて初心者向け情報、クエスト、キャラクター、アイテム、ビルド、ロケーション、不具合対策を追加します。",
    releaseQ: `${title}の発売日はいつですか？`, platformQ: `${title}の対応プラットフォームは？`, developerQ: `${title}の開発会社は？`,
    fullWiki: "完全版の独立Wikiを開く", fullWikiSub: "攻略、データベース、ビルド、詳しいプレイヤー向け情報", verified: "確認済み情報", updated: "構造化されたゲームデータと確認済みの情報源を基に更新しています。未確認情報を事実として掲載しません。", sources: "情報源", guidesCta: "攻略を見る"
  }
}[locale] || {};
const faqItems = buildFaqItems(game, locale);
const faqJsonLd = {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })),
};
---
{!isDraft && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
{!isDraft && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

<div class="detail-wrap">
  <div class="crumb">
    <a href={`/${locale}/`}>{t(locale, "breadcrumbBack")}</a>
    {game.genres?.[0] && (
      <>
        <span aria-hidden="true">/</span>
        <a href={`/${locale}/genre/${slugify(game.genres[0])}/`}>{genresLocalized[0]}</a>
      </>
    )}
    <span aria-hidden="true">/</span>
    <span>{title}</span>
  </div>

  {isDraft && <div class="draft-banner">{t(locale, "draftBanner")}</div>}

  <div class="detail-hero" style={`background:linear-gradient(135deg, ${game.grad[0]}, ${game.grad[1]})`}>
    {game.cover
      ? <img class="cover-img" src={game.cover} alt={`${title} banner`} decoding="async" style={`object-position:${game.coverPosition || "center"}`} />
      : <div class="mono">{game.mono}</div>}
  </div>

  <div class="detail-title-row">
    <h1 class="detail-title">{title}</h1>
    {!isDraft && <button class="game-watch-btn" type="button" data-game-watch aria-pressed="false">{product.saveGame}</button>}
  </div>
  {locale === "zh" && game.titleEn && game.titleEn !== title && <div class="detail-en">{game.titleEn}</div>}

  <dl class="facts">
    <dt>{t(locale, "factReleaseDate")}</dt>
    <dd>{fmtDate(game.release, locale)}{releaseRelative}</dd>
    {game.developer && <><dt>{t(locale, "factDeveloper")}</dt><dd>{game.developer}</dd></>}
    {game.publisher && <><dt>{t(locale, "factPublisher")}</dt><dd>{game.publisher}</dd></>}
    <dt>{t(locale, "factPlatforms")}</dt>
    <dd>{game.platforms?.length
      ? (isDraft ? game.platforms.join(separator) : game.platforms.map((p, i) => <>{i > 0 && separator}<a href={`/${locale}/platform/${slugify(p)}/`} style="color:inherit; text-decoration:underline; text-underline-offset:2px;">{p}</a></>))
      : "—"}</dd>
    <dt>{t(locale, "factGenres")}</dt>
    <dd>{game.genres?.length
      ? (isDraft ? genresLocalized.join(separator) : game.genres.map((g, i) => <>{i > 0 && separator}<a href={`/${locale}/genre/${slugify(g)}/`} style="color:inherit; text-decoration:underline; text-underline-offset:2px;">{genresLocalized[i]}</a></>))
      : "—"}</dd>
  </dl>

  {game.platforms?.length > 0 && (
    <section class="wiki-section" aria-labelledby="platform-matrix-title">
      <h2 id="platform-matrix-title">{product.platformMatrix}</h2>
      <div class="platform-matrix-wrap">
        <table class="platform-matrix">
          <thead><tr><th>{product.platform}</th><th>{product.availability}</th><th>{product.releaseDate}</th></tr></thead>
          <tbody>
            {game.platforms.map((platform) => (
              <tr>
                <td>{isDraft ? platform : <a href={`/${locale}/platform/${slugify(platform)}/`}>{platform}</a>}</td>
                <td><span class={`availability ${status}`}>{status === "live" ? product.availableNow : product.planned}</span></td>
                <td>{fmtDate(game.release, locale)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="wiki-section" aria-labelledby="overview-title">
    <p class="section-kicker">{copy.verified}</p>
    <h2 id="overview-title">{copy.overview}</h2>
    <p>{editorial.summary || copy.overviewText}</p>
  </section>

  {game.coverage === "owned" && game.wikiUrl && game.wikiUrl !== "#" && (
    <aside class="owned-wiki-cta">
      <div><b>{copy.fullWiki}</b><span>{copy.fullWikiSub}</span></div>
      <a href={game.wikiUrl} target="_blank" rel="noopener">{copy.fullWiki} →</a>
    </aside>
  )}

  <section class="wiki-section" aria-labelledby="answers-title">
    <h2 id="answers-title">{copy.quick}</h2>
    <div class="answer-list">
      {faqItems.map((item) => <article><h3>{item.question}</h3><p>{item.answer}</p></article>)}
    </div>
    <p style="margin-top:16px; display:flex; gap:20px; flex-wrap:wrap">
      {faqIndexable && <a href={`/${locale}/games/${game.slug}/faq/`} style="color:var(--indigo); font-weight:700; text-decoration:none; font-size:14px">{t(locale, "viewFullFaqCta")}</a>}
      {releaseIndexable && <a href={`/${locale}/games/${game.slug}/release-date/`} style="color:var(--indigo); font-weight:700; text-decoration:none; font-size:14px">{t(locale, "viewReleaseDateCta")}</a>}
      {hasGameNews && <a href={`/${locale}/games/${game.slug}/news/`} style="color:var(--indigo); font-weight:700; text-decoration:none; font-size:14px">{t(locale, "viewGameNewsCta")}</a>}
    </p>
  </section>

  <section class="wiki-section" aria-labelledby="guides-title">
    <h2 id="guides-title">{copy.guides}</h2>
    {editorial.guideSections?.length ? (
      <div class="guide-section-grid">
        {editorial.guideSections.map((section) => (
          <article><h3>{section.title}</h3><p>{section.description}</p>{section.href && <a href={section.href}>{section.cta || copy.guidesCta} →</a>}</article>
        ))}
      </div>
    ) : <p>{copy.guidesText}</p>}
  </section>

  {latestUpdate && (
    <section class="wiki-section tracked-update" aria-labelledby="tracked-update-title">
      <p class="section-kicker">{product.externalUpdate}</p>
      <h2 id="tracked-update-title">{product.latestUpdate}</h2>
      <a class="tracked-update-link" href={latestUpdate.url} target="_blank" rel="noopener noreferrer">{latestUpdate.title} ↗</a>
      <p>{latestUpdate.source} · <time datetime={latestUpdate.publishedAt}>{fmtDate(latestUpdate.publishedAt, locale)}</time></p>
    </section>
  )}

  <section class="wiki-section source-section">
    <h2>{copy.sources}</h2>
    <p class="source-summary"><strong>{product.sourceTransparency}:</strong> {editorial.sources?.length || 0} {product.sourceCount} · {product.dataAsOf}: {dataUpdated}</p>
    {editorial.sources?.length > 0 && <ol>{editorial.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}</ol>}
  </section>

  {relatedGames.length > 0 && (
    <section class="wiki-section" aria-labelledby="related-games-title">
      <h2 id="related-games-title">{t(locale, "relatedGames")}</h2>
      <div class="grid" style="margin-top:14px">
        {relatedGames.map((g) => <GameCard game={g} locale={locale} />)}
      </div>
    </section>
  )}

  <p class="detail-lbl">{t(locale, "relatedLinks")}</p>
  <div class="links">
    {links.length
      ? links.map((l) => (
          <a class="lk" href={l.url} target="_blank" rel="noopener">
            <span class="ico">{l.icon}</span>
            <span class="meta">{l.name}<small>{l.sub}</small></span>
            <svg class="arr" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </a>
        ))
      : <div class="empty" style="padding:20px 0">{t(locale, "noLinks")}</div>}
  </div>

  <div class="note">{copy.updated}</div>
</div>

{!isDraft && (
  <script define:vars={{ watchSlug: game.slug, watchLabel: product.saveGame, watchedLabel: product.savedGame }}>
    const watchButton = document.querySelector("[data-game-watch]");
    const storageKey = "gr_watchlist";
    const readWatchlist = () => {
      try {
        const value = JSON.parse(localStorage.getItem(storageKey) || "[]");
        return Array.isArray(value) ? value.filter((item) => typeof item === "string") : [];
      } catch { return []; }
    };
    const renderWatchButton = () => {
      if (!watchButton) return;
      const saved = readWatchlist().includes(watchSlug);
      watchButton.textContent = saved ? watchedLabel : watchLabel;
      watchButton.setAttribute("aria-pressed", String(saved));
    };
    watchButton?.addEventListener("click", () => {
      const watchlist = readWatchlist();
      const next = watchlist.includes(watchSlug)
        ? watchlist.filter((slug) => slug !== watchSlug)
        : [...watchlist, watchSlug];
      localStorage.setItem(storageKey, JSON.stringify(next));
      renderWatchButton();
    });
    renderWatchButton();
  </script>
)}

<style>
  .detail-title-row { display:flex; align-items:flex-end; justify-content:space-between; gap:18px; }
  .detail-title-row .detail-title { margin-bottom:0; }
  .game-watch-btn { flex:0 0 auto; border:1px solid var(--indigo); background:transparent; color:var(--indigo); border-radius:999px; padding:9px 14px; font:700 12px var(--fb); cursor:pointer; }
  .game-watch-btn[aria-pressed="true"] { background:var(--indigo); color:white; }
  .platform-matrix-wrap { overflow-x:auto; border:1px solid var(--line-soft); border-radius:var(--r-sm); }
  .platform-matrix { width:100%; min-width:520px; border-collapse:collapse; font-size:13px; }
  .platform-matrix th,.platform-matrix td { text-align:left; padding:12px 14px; border-bottom:1px solid var(--line-soft); }
  .platform-matrix tr:last-child td { border-bottom:0; }
  .platform-matrix th { color:var(--faint); font-size:11px; text-transform:uppercase; letter-spacing:.04em; background:var(--panel-2); }
  .platform-matrix a,.tracked-update-link,.source-section a { color:var(--indigo); font-weight:700; text-decoration:none; }
  .availability { display:inline-flex; border-radius:999px; padding:4px 8px; background:color-mix(in srgb,var(--amber) 15%,transparent); color:var(--amber); font-size:11px; font-weight:800; }
  .availability.live { background:color-mix(in srgb,var(--teal) 14%,transparent); color:var(--teal); }
  .tracked-update-link { display:inline-block; line-height:1.5; }
  .tracked-update > p:last-child,.source-summary { color:var(--muted); font-size:13px; }
  .source-section ol { padding-left:20px; }
  @media(max-width:640px){.detail-title-row{align-items:flex-start;flex-direction:column}.game-watch-btn{margin-bottom:4px}}
</style>
