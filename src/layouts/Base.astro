---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import { SITE } from "../../site.config.mjs";

const { title, description, currentSlug = "", withInfobox = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.shortName} Wiki` : SITE.name;
const pageDesc = description || SITE.description;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <style define:vars={{ accent: SITE.accent }}>:root { --accent: var(--accent); }</style>
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content={new URL(SITE.banner, SITE.url).toString()} />
</head>
<body>
  <header class="hdr">
    <div class="wrap hdr-inner">
      <a class="brand" href="/">
        <img src={SITE.logo} alt="" onerror="this.style.display='none'" />
        <b>{SITE.shortName}</b>
      </a>
      <div class="hdr-search" id="search-mount"></div>
    </div>
  </header>

  <div class="wrap">
    <div class:list={["shell", { "with-infobox": withInfobox }]}>
      <Sidebar currentSlug={currentSlug} />
      <main>
        <slot />
      </main>
      {withInfobox && <div class="infobox-rail"><slot name="infobox" /></div>}
    </div>
  </div>

  <footer class="ftr">
    <div class="wrap ftr-inner">
      <span>{SITE.shortName} Wiki — fan-maintained guide, not affiliated with the game's publisher.</span>
      <span><a href="/">Main page</a></span>
    </div>
  </footer>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline define:vars={{ placeholder: `Search ${SITE.shortName} Wiki` }}>
    window.addEventListener("DOMContentLoaded", () => {
      if (!window.PagefindUI) return;
      new window.PagefindUI({
        element: "#search-mount",
        showSubResults: true,
        showImages: false,
        translations: { placeholder },
      });
    });
  </script>
</body>
</html>
