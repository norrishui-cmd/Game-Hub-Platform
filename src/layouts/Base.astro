---
import "../styles/global.css";
import { LOCALES, LOCALE_META, DEFAULT_LOCALE, buildAlternates } from "../i18n/locales.js";
import { t } from "../i18n/ui.js";
import { TRUST } from "../i18n/trust.js";
import { PRODUCT } from "../i18n/product.js";
import { P2 } from "../i18n/p2.js";
import { P3 } from "../i18n/p3.js";
import { SITE } from "../config/site.js";
import gamesData from "../../data/games.json";
import { displayTitle, translateGenres } from "../lib/games.js";

const {
  locale = DEFAULT_LOCALE,
  title,
  description,
  noindex = false,
  indexableLocales = LOCALES,
  pathSuffix = "", // 不带 locale 前缀的路径部分，比如 "/games/gta-6/"，用来拼 hreflang
  image, // 可选：这个页面专属的分享图（比如某款游戏的封面），不传就用全站默认的分享图
  ogType = "website", // 游戏详情页可以传 "article"，其余页面用默认的 "website" 就好
  jsonLd = [], // 页面自己的结构化数据（数组或单个对象都行），跟 Base 自动加的 WebSite/Organization 一起输出
} = Astro.props;

const desc = description || t(locale, "metaDescHome");
const alternates = buildAlternates(pathSuffix);
const visibleAlternates = LOCALES.filter((l) => indexableLocales.includes(l));
const canonical = new URL(alternates[locale], Astro.site).toString();
const ogImage = new URL(image || "/images/og-default.jpg", Astro.site).toString();
const fullTitle = title || "GameRadar · Game Guide Radar";
const trust = TRUST[locale] || TRUST.en;
const product = PRODUCT[locale] || PRODUCT.en;
const p2 = P2[locale] || P2.en;
const p3 = P3[locale] || P3.en;
const searchIndex = gamesData.games.map((game) => ({
  slug: game.slug,
  title: displayTitle(game, locale),
  subtitle: [game.developer, ...(translateGenres(game.genres || [], locale).slice(0, 2))].filter(Boolean).join(" · "),
  text: [displayTitle(game, locale), game.titleEn, game.developer, ...(game.genres || []), ...(game.platforms || [])].filter(Boolean).join(" "),
  href: `/${locale}/games/${game.slug}/`,
}));
const dataUpdated = new Date(gamesData.generatedAt).toLocaleString(LOCALE_META[locale]?.htmlLang || "en", {
  year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "UTC", timeZoneName: "short",
});

// 全站通用的两块结构化数据：WebSite（带 SearchAction，方便 Google 识别站内搜索、
// 有机会拿到搜索结果里的 Sitelinks 搜索框）和 Organization（品牌实体信息）。
// 每个页面自己的结构化数据（VideoGame/FAQPage/BreadcrumbList 等）通过 jsonLd prop 传进来，
// 跟这两块一起原样输出，不用每个页面重复写 WebSite/Organization 这两块。
const siteJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: new URL(`/${locale}/`, Astro.site).toString(),
    potentialAction: {
      "@type": "SearchAction",
      target: `${new URL(`/${locale}/games/`, Astro.site).toString()}?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: new URL("/", Astro.site).toString(),
    logo: new URL("/images/og-default.jpg", Astro.site).toString(),
  },
];
const allJsonLd = [...siteJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])].filter(Boolean);
---
<!doctype html>
<html lang={LOCALE_META[locale]?.htmlLang || "en"}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-adsense-account" content="ca-pub-9505220977121599" />
  {!noindex && <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9505220977121599" crossorigin="anonymous"></script>}
  <title>{title}</title>
  <meta name="description" content={desc} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <link rel="canonical" href={canonical} />

  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={LOCALE_META[locale]?.htmlLang?.replace("-", "_") || "en_US"} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={ogImage} />

  {allJsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

  {Astro.site && visibleAlternates.map((l) => (
    <link rel="alternate" hreflang={LOCALE_META[l].htmlLang} href={new URL(alternates[l], Astro.site).toString()} />
  ))}
  {Astro.site && visibleAlternates.includes(DEFAULT_LOCALE) && <link rel="alternate" hreflang="x-default" href={new URL(alternates[DEFAULT_LOCALE], Astro.site).toString()} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="hdr">
    <a class="brand" href={`/${locale}/`} aria-label={t(locale, "tagline")}>
      <span class="glyph"><b>◈</b></span>
      <span class="t"><b>{SITE.name}</b><span>{t(locale, "tagline")}</span></span>
    </a>
    <div class="search" role="search">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4-4"/></svg>
      <input id="q" type="search" placeholder={t(locale, "searchPlaceholder")} aria-label={t(locale, "searchAria")} aria-autocomplete="list" aria-controls="search-suggest" aria-expanded="false" autocomplete="off" />
      <div id="search-suggest" class="search-suggest" role="listbox" hidden></div>
    </div>
    <button id="nav-toggle" class="nav-toggle" type="button" aria-controls="main-nav" aria-expanded="false"><span class="sr-only">{product.menu}</span><span></span><span></span><span></span></button>
    <nav class="nav" id="main-nav">
      <a href={`/${locale}/games/`}>{product.allGames}</a>
      <a href={`/${locale}/#upcoming`}>{t(locale, "navUpcoming")}</a>
      <a href={`/${locale}/#trending`}>{t(locale, "navTrending")}</a>
      <a href={`/${locale}/monthly-chart/`}>{t(locale, "navMonthlyChart")}</a>
      <a href={`/${locale}/releases/`}>{t(locale, "navReleases")}</a>
      <a href={`/${locale}/news/`}>{t(locale, "navNews")}</a>
      <details class="nav-tools">
        <summary>{p2.tools}</summary>
        <div><a href={`/${locale}/discover/`}>{p3.discoverGames}</a><a href={`/${locale}/watchlist/`}>{p2.myRadar}<span id="nav-radar-count" class="nav-radar-count" hidden></span></a><a href={`/${locale}/compare/`}>{p2.compareGames}</a></div>
      </details>
      <a href={`/${locale}/about/`}>{trust.companyNav}</a>
    </nav>
    <label class="lang-switch"><span class="sr-only">{product.language}</span><select id="language-select" aria-label={product.language}>{LOCALES.map((l) => <option value={alternates[l]} selected={l === locale}>{LOCALE_META[l].label}</option>)}</select></label>
  </header>

  <slot />

  <footer id="foot">
    <div class="foot-in">
      <div>
        <a class="brand" href={`/${locale}/`}><span class="glyph"><b>◈</b></span><span class="t"><b>{SITE.name}</b><span>{t(locale, "tagline")}</span></span></a>
        <p>{t(locale, "footerDesc")}</p>
      </div>
      <div class="foot-cols">
        <div class="foot-col">
          <b>{t(locale, "footerBrowse")}</b>
          <a href={`/${locale}/games/`}>{product.allGames}</a>
          <a href={`/${locale}/#upcoming`}>{t(locale, "navUpcoming")}</a>
          <a href={`/${locale}/#trending`}>{t(locale, "navTrending")}</a>
          <a href={`/${locale}/monthly-chart/`}>{t(locale, "navMonthlyChart")}</a>
          <a href={`/${locale}/releases/`}>{t(locale, "navReleases")}</a>
          <a href={`/${locale}/news/`}>{t(locale, "navNews")}</a>
          <a href={`/${locale}/discover/`}>{p3.discoverGames}</a>
          <a href={`/${locale}/watchlist/`}>{p2.myRadar}</a>
          <a href={`/${locale}/compare/`}>{p2.compareGames}</a>
          <a href={`/${locale}/faq/`}>{t(locale, "navFaq")}</a>
          <a href={`/${locale}/genres/`}>{t(locale, "footerGenres")}</a>
          <a href={`/${locale}/platforms/`}>{t(locale, "footerPlatforms")}</a>
        </div>
        <div class="foot-col">
          <b>{t(locale, "footerRules")}</b>
          <a href={`/${locale}/about/#editorial`}>{t(locale, "footerRules")}</a>
          <a href={`/${locale}/about/#sources`}>{t(locale, "footerDataSource")}</a>
          <a href={`/${locale}/about/#corrections`}>{trust.correctionsNav}</a>
        </div>
        <div class="foot-col">
          <b>{t(locale, "footerMyWikis")}</b>
          <a href="https://starwarszerocompany.cc" target="_blank" rel="noopener">Star Wars: Zero Company</a>
        </div>
        <div class="foot-col">
          <b>{trust.companyNav}</b>
          <a href={`/${locale}/about/`}>{trust.aboutNav}</a>
          <a href={`/${locale}/privacy/`}>{trust.privacyNav}</a>
          <a href={`/${locale}/terms/`}>{trust.termsNav}</a>
        </div>
      </div>
    </div>
    <div class="foot-legal">
      <span>© 2026 {SITE.name} · {t(locale, "footerLegal")}</span>
      <span>{trust.dataUpdated}: {dataUpdated}</span>
    </div>
  </footer>

  <script define:vars={{ locale, searchIndex, searchLabels: { all: product.searchAll } }}>
    // 记住这次访问用的是哪个语言——根路径的自动跳转脚本会优先读这个，
    // 而不是每次都重新猜浏览器语言。这样手动切换过语言的人不会被"猜"回去。
    try { localStorage.setItem("gr_locale", locale); } catch (e) {}

    const header = document.querySelector(".hdr");
    const navToggle = document.querySelector("#nav-toggle");
    const nav = document.querySelector("#main-nav");
    navToggle?.addEventListener("click", () => {
      const open = !header.classList.contains("nav-open");
      header.classList.toggle("nav-open", open);
      navToggle.setAttribute("aria-expanded", String(open));
    });
    nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { header.classList.remove("nav-open"); navToggle?.setAttribute("aria-expanded", "false"); }));
    document.querySelector("#language-select")?.addEventListener("change", (event) => { window.location.href = event.target.value; });
    const radarCount = document.querySelector("#nav-radar-count");
    const updateRadarCount = () => {
      if (!radarCount) return;
      try {
        const saved = JSON.parse(localStorage.getItem("gr_watchlist") || "[]");
        const count = Array.isArray(saved) ? new Set(saved.filter((value) => typeof value === "string")).size : 0;
        radarCount.textContent = String(count); radarCount.hidden = count === 0;
      } catch { radarCount.hidden = true; }
    };
    window.addEventListener("storage", (event) => { if (event.key === "gr_watchlist") updateRadarCount(); });
    window.addEventListener("gr-watchlist-change", updateRadarCount);
    updateRadarCount();

    const q = document.querySelector("#q");
    const suggest = document.querySelector("#search-suggest");
    let matches = [];
    let active = -1;
    const norm = (value) => String(value || "").toLocaleLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    function editDistance(a, b) {
      if (Math.abs(a.length - b.length) > 2) return 3;
      const row = Array.from({length:b.length + 1}, (_, i) => i);
      for (let i = 1; i <= a.length; i++) { let prev = row[0]; row[0] = i; for (let j = 1; j <= b.length; j++) { const old = row[j]; row[j] = Math.min(row[j] + 1, row[j - 1] + 1, prev + (a[i - 1] === b[j - 1] ? 0 : 1)); prev = old; } }
      return row[b.length];
    }
    function score(item, needle) {
      const title = norm(item.title); const text = norm(item.text); const words = title.split(/\s+/);
      if (title === needle) return 120;
      if (title.startsWith(needle)) return 100;
      if (words.some((word) => word.startsWith(needle))) return 85;
      if (title.includes(needle)) return 75;
      if (text.includes(needle)) return 55;
      if (needle.length >= 4 && words.some((word) => editDistance(word, needle) <= 2)) return 35;
      return 0;
    }
    function closeSearch() { suggest.hidden = true; q.setAttribute("aria-expanded", "false"); q.removeAttribute("aria-activedescendant"); active = -1; }
    function setActive(index) {
      const options = [...suggest.querySelectorAll('[role="option"]')];
      active = Math.max(-1, Math.min(index, options.length - 1));
      options.forEach((option, i) => { option.classList.toggle("active", i === active); option.setAttribute("aria-selected", String(i === active)); });
      if (active >= 0) { q.setAttribute("aria-activedescendant", options[active].id); options[active].scrollIntoView({block:"nearest"}); }
      else q.removeAttribute("aria-activedescendant");
    }
    function renderSearch() {
      const needle = norm(q.value.trim()); suggest.replaceChildren(); active = -1;
      if (needle.length < 2) { closeSearch(); return; }
      matches = searchIndex.map((item) => ({item, score:score(item, needle)})).filter((entry) => entry.score > 0).sort((a,b) => b.score - a.score).slice(0, 6).map((entry) => entry.item);
      for (const [index, item] of matches.entries()) {
        const link = document.createElement("a"); link.href = item.href; link.id = `search-option-${index}`; link.setAttribute("role", "option"); link.setAttribute("aria-selected", "false");
        const title = document.createElement("b"); title.textContent = item.title; const sub = document.createElement("span"); sub.textContent = item.subtitle;
        link.append(title, sub); suggest.append(link);
      }
      const all = document.createElement("a"); all.href = `/${locale}/games/?q=${encodeURIComponent(q.value.trim())}`; all.id = "search-option-all"; all.className = "search-all"; all.setAttribute("role", "option"); all.setAttribute("aria-selected", "false"); all.textContent = `${searchLabels.all} →`; suggest.append(all);
      suggest.hidden = false; q.setAttribute("aria-expanded", "true");
    }
    const preset = new URLSearchParams(location.search).get("q"); if (preset) q.value = preset;
    q?.addEventListener("input", renderSearch);
    q?.addEventListener("focus", () => { if (q.value.trim().length >= 2) renderSearch(); });
    q?.addEventListener("keydown", (event) => {
      const options = [...suggest.querySelectorAll('[role="option"]')];
      if (event.key === "ArrowDown") { event.preventDefault(); if (suggest.hidden) renderSearch(); setActive(active + 1); }
      else if (event.key === "ArrowUp") { event.preventDefault(); if (suggest.hidden) renderSearch(); setActive(active < 0 ? [...suggest.querySelectorAll('[role="option"]')].length - 1 : active - 1); }
      else if (event.key === "Escape") closeSearch();
      else if (event.key === "Enter" && q.value.trim()) { event.preventDefault(); if (active >= 0 && options[active]) options[active].click(); else window.location.href = `/${locale}/games/?q=${encodeURIComponent(q.value.trim())}`; }
    });
    document.addEventListener("pointerdown", (event) => { if (!event.target.closest(".search")) closeSearch(); });
  </script>
</body>
</html>
