---
import Base from "../../../layouts/Base.astro";
import GameCard from "../../../components/GameCard.astro";
import gamesData from "../../../../data/games.json";
import { LOCALES } from "../../../i18n/locales.js";
import { t } from "../../../i18n/ui.js";
import { p2Text } from "../../../i18n/p2.js";
import { slugify, collectTaxonomy, translateGenre, displayTitle, buildBreadcrumbJsonLd, buildCollectionJsonLd } from "../../../lib/games.js";

export function getStaticPaths() {
  const genres = collectTaxonomy(gamesData.games, "genres");
  return LOCALES.flatMap((locale) =>
    genres.map(({ label, slug }) => ({
      params: { locale, genre: slug },
      props: { label, games: gamesData.games.filter((g) => (g.genres || []).some((x) => slugify(x) === slug)) },
    }))
  );
}

const { locale } = Astro.params;
const { label, games } = Astro.props;
const localizedLabel = translateGenre(label, locale);
const indexable = locale === "en" && games.length >= 3;
const intro = p2Text(locale, "genreCollectionIntro", { label: localizedLabel });
const site = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "";
const pageUrl = `${site}/${locale}/genre/${slugify(label)}/`;
const jsonLd = indexable ? [
  buildBreadcrumbJsonLd([{ name:"GameRadar", url:`${site}/${locale}/` }, { name:t(locale, "genresPageTitle"), url:`${site}/${locale}/genres/` }, { name:localizedLabel, url:pageUrl }]),
  buildCollectionJsonLd({ name:localizedLabel, description:intro, url:pageUrl, locale, items:games.map((game) => ({ name:displayTitle(game, locale), url:`${site}/${locale}/games/${game.slug}/`, image:game.cover ? (game.cover.startsWith("/") ? `${site}${game.cover}` : game.cover) : undefined })) }),
] : [];
---
<Base
  locale={locale}
  title={`${localizedLabel} | GameRadar`}
  description={t(locale, "genreMetaDesc", localizedLabel, games.length)}
  pathSuffix={`/genre/${slugify(label)}/`}
  noindex={!indexable}
  indexableLocales={indexable ? ["en"] : []}
  jsonLd={jsonLd}
>
  <main class="wrap" style="padding-top:28px">
    <div class="crumb"><a href={`/${locale}/`}>{t(locale, "breadcrumbBack")}</a><span aria-hidden="true">/</span><a href={`/${locale}/genres/`}>{t(locale, "genresPageTitle")}</a></div>
    <div class="rail-head">
      <h1><span class="bar" style="background:var(--indigo)"></span>{localizedLabel}</h1>
      <span class="count">{games.length} {t(locale, "countSuffix")}</span>
    </div>
    <p style="max-width:76ch;color:var(--muted);margin:-6px 0 22px">{intro}</p>
    <div class="grid">{games.map((g) => <GameCard game={g} locale={locale} />)}</div>
  </main>
</Base>
