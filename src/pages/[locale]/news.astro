---
import Base from "../../layouts/Base.astro";
import NewsList from "../../components/NewsList.astro";
import newsData from "../../../data/news.json";
import { LOCALES } from "../../i18n/locales.js";
import { t } from "../../i18n/ui.js";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const DATE_TAG = { zh: "zh-CN", en: "en-US", es: "es-ES", de: "de-DE", ja: "ja-JP" };
const updatedLabel = new Date(newsData.generatedAt).toLocaleDateString(DATE_TAG[locale] || "en-US", {
  year: "numeric", month: "long", day: "numeric",
});
---
<Base
  locale={locale}
  title={`${t(locale, "newsHeading")} | GameRadar`}
  description={t(locale, "newsSubtitle")}
  pathSuffix="/news/"
  noindex={locale !== "en"}
  indexableLocales={["en"]}
>
  <main class="wrap" style="padding-top:28px; max-width:760px">
    <div class="crumb"><a href={`/${locale}/`}>{t(locale, "breadcrumbBack")}</a></div>
    <div class="rail-head" style="flex-direction:column; align-items:flex-start; gap:6px">
      <h1><span class="bar" style="background:var(--teal)"></span>{t(locale, "newsHeading")}</h1>
      <p style="margin:0; color:var(--muted); font-size:15px">{t(locale, "newsSubtitle")}</p>
    </div>
    <p style="color:var(--faint); font-size:13px; margin:0 0 22px">{t(locale, "newsUpdatedLabel")} {updatedLabel}</p>

    {newsData.items.length > 0
      ? <NewsList items={newsData.items} locale={locale} />
      : <p class="note">{t(locale, "newsEmpty")}</p>}
  </main>
</Base>
