---
import Base from "../../../layouts/Base.astro"; import { LOCALES } from "../../../i18n/locales.js";
const data={"upcoming-watchlist":"What upcoming game are you watching most closely?","beginner-guide":"Which game hub needs a clearer beginner guide?","release-source":"Share a verified release-date source","next-feature":"What should we add to GameRadar next?"}; export function getStaticPaths(){const slugs=["upcoming-watchlist","beginner-guide","release-source","next-feature"]; return LOCALES.flatMap(locale=>slugs.map(slug=>({params:{locale,slug}})));} const {locale,slug}=Astro.params; const title=data[slug];
---
<Base locale={locale} title={`${title} | GameRadar Community`} description="A moderated GameRadar player discussion." pathSuffix={`/community/${slug}/`} noindex={true} indexableLocales={[]}><main class="wrap post"><p class="crumb"><a href={`/${locale}/community/`}>← Community</a></p><article><div>▲<b id="score">24</b>▼</div><div><p>r/GameRadar · Discussion</p><h1>{title}</h1><p>Share useful context, cite official sources for factual claims, and keep spoilers out of the title.</p></div></article><h2>Comments</h2><div class="comment"><b>Player_17</b><p>A useful answer should mention platform and source.</p></div><form id="comment"><textarea required placeholder="Add a helpful comment…"></textarea><button class="btn">Comment</button></form></main><script>document.querySelector('#comment')?.addEventListener('submit',e=>{e.preventDefault();const t=e.currentTarget.querySelector('textarea');if(t.value.trim()){const d=document.createElement('div');d.className='comment';d.textContent='You · pending review — '+t.value;t.before(d);t.value=''}})</script></Base><style>.post{max-width:820px;padding-top:28px}.post article{display:grid;grid-template-columns:42px 1fr;gap:16px;padding:24px;background:var(--panel);border:1px solid var(--line);border-radius:var(--r)}.post article>div:first-child{display:flex;flex-direction:column;align-items:center;color:var(--faint)}h1{font:700 clamp(26px,4vw,40px) var(--fd);margin:8px 0}.post p{color:var(--muted);line-height:1.6}.post h2{margin-top:28px}.comment{padding:14px;margin:10px 0;background:var(--panel);border-left:2px solid var(--line)}textarea{width:100%;min-height:88px;padding:10px;background:var(--panel);border:1px solid var(--line);color:var(--ink);border-radius:8px}form{display:grid;gap:9px}</style>
