---
import Base from "../../layouts/Base.astro";
import { LOCALES } from "../../i18n/locales.js";
export function getStaticPaths(){return LOCALES.map(locale=>({params:{locale}}));}
const {locale}=Astro.params;
const copy={en:{title:"GameRadar Community",intro:"Ask useful questions, share confirmed discoveries, and help other players decide what to play next.",post:"Start a discussion",hot:"Hot discussions",rules:"Community rules"},zh:{title:"GameRadar 社区",intro:"提问、分享已核实的发现，并帮助其他玩家决定下一款游戏。",post:"发起讨论",hot:"热门讨论",rules:"社区规则"},es:{title:"Comunidad GameRadar",intro:"Haz preguntas útiles, comparte hallazgos confirmados y ayuda a otros jugadores.",post:"Iniciar debate",hot:"Debates populares",rules:"Normas"},de:{title:"GameRadar Community",intro:"Stelle hilfreiche Fragen, teile bestätigte Entdeckungen und hilf anderen Spielern.",post:"Diskussion starten",hot:"Beliebte Diskussionen",rules:"Regeln"},ja:{title:"GameRadar コミュニティ",intro:"役立つ質問や確認済みの発見を共有し、他のプレイヤーを助けましょう。",post:"ディスカッションを始める",hot:"注目の話題",rules:"ルール"}}[locale]||{};
const topics=["What upcoming game are you watching most closely?","Which game hub needs a clearer beginner guide?","Share a verified release-date source","What should we add to GameRadar next?"];
---
<Base locale={locale} title={`${copy.title} | GameRadar`} description={copy.intro} pathSuffix="/community/" noindex={true} indexableLocales={[]}>
<main class="wrap community"><div class="crumb"><a href={`/${locale}/`}>← GameRadar</a></div><header><p class="section-kicker">PLAYER-LED · MODERATED</p><h1>{copy.title}</h1><p>{copy.intro}</p><button class="btn" type="button" id="new-post">＋ {copy.post}</button></header><div class="community-grid"><section><h2>{copy.hot}</h2>{topics.map((topic,i)=><article class="thread"><div class="vote">▲<b>{24-i*4}</b>▼</div><div><span>r/GameRadar · Discussion</span><h3>{topic}</h3><p>{8+i*3} comments · {i+1}h ago</p></div></article>)}</section><aside><h2>{copy.rules}</h2><ol><li>Be helpful and respectful.</li><li>Link official sources for factual claims.</li><li>No spoilers in titles.</li><li>No spam, harassment, or piracy.</li></ol></aside></div><dialog id="post-dialog"><form method="dialog"><h2>{copy.post}</h2><input placeholder="Title" required/><textarea placeholder="Share context, a question, or a source…" required></textarea><button class="btn">Submit for review</button></form></dialog></main>
<script>document.querySelector('#new-post')?.addEventListener('click',()=>document.querySelector('#post-dialog')?.showModal())</script>
</Base>
<style>.community{padding-top:30px;max-width:1080px}.community header{padding:28px;background:linear-gradient(135deg,var(--panel),var(--panel-2));border:1px solid var(--line);border-radius:var(--r)}.community h1{font:700 clamp(30px,5vw,46px) var(--fd);margin:6px 0}.community header p{color:var(--muted);max-width:64ch;line-height:1.6}.community-grid{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:18px;margin-top:24px}.community h2{font:700 20px var(--fd)}.thread{display:grid;grid-template-columns:45px 1fr;gap:12px;padding:16px;background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;margin-bottom:10px}.vote{display:flex;flex-direction:column;align-items:center;color:var(--faint);font-size:12px}.vote b{color:var(--ink)}.thread span,.thread p{font-size:12px;color:var(--faint)}.thread h3{margin:6px 0;font:700 17px var(--fd)}.thread p{margin:0}aside{padding:18px;background:var(--panel);border:1px solid var(--line-soft);border-radius:12px;height:max-content}aside li{color:var(--muted);margin:10px 0;font-size:13px;line-height:1.45}dialog{color:var(--ink);background:var(--bg-2);border:1px solid var(--line);border-radius:14px;width:min(520px,90vw)}dialog form{display:grid;gap:12px}dialog input,dialog textarea{padding:11px;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink)}dialog textarea{min-height:130px}@media(max-width:720px){.community-grid{grid-template-columns:1fr}}</style>
