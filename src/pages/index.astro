---
import Base from "../layouts/Base.astro";
import { getAllArticles, getArticlesByCategory, categoryHref } from "../lib/wiki.js";
import { SITE } from "../../site.config.mjs";

const all = await getAllArticles();
const grouped = await getArticlesByCategory();
---
<Base currentSlug="__home">
  <div class="banner">
    <img src={SITE.banner} alt={SITE.bannerAlt} />
    <div class="banner-cap">{SITE.shortName} Wiki</div>
  </div>

  <div class="welcome-grid">
    <div>
      <h2>Welcome to the {SITE.shortName} Wiki</h2>
      <p>{SITE.description}</p>
    </div>
    <div>
      <h2>This wiki</h2>
      <p><span class="stat">{all.length}</span> article{all.length === 1 ? "" : "s"} and counting.</p>
    </div>
  </div>

  <div class="cat-grid">
    {grouped.map((cat) => (
      <a class="cat-card" href={categoryHref(cat.slug)}>
        <span class="ic">{cat.icon}</span>
        <b>{cat.label}</b>
        <span>{cat.description}</span>
        <span class="n">{cat.articles.length} article{cat.articles.length === 1 ? "" : "s"}</span>
      </a>
    ))}
  </div>
</Base>
